diff --git a/src/ula.c b/src/ula.c
index 6baac38..b32c3d7 100644
--- a/src/ula.c
+++ b/src/ula.c
@@ -117,28 +117,112 @@ void initula()
 
 int fullblit=0;
 
+/* Scaled fullscreen (Linux).
+   Allegro 4 changes resolution with XF86VidMode, which modern X servers
+   (e.g. the Raspberry Pi KMS/modesetting driver) no longer support, so the
+   old 800x600 request left a small picture in the corner of a full-size
+   screen.  Instead, fullscreen now uses the current desktop resolution and
+   scales the 640x512 picture to fit.
+   fullscreen_scale (elk.cfg): 0 = largest integer scale (sharp, default)
+                               1 = 4:3 aspect
+                               2 = fill the whole screen */
+int fs_scale=0;
+/* display_scale (elk.cfg): not used by Elkulator itself - the RetroPie
+   launcher reads it.  2 = X runs at half the TV resolution, doubled by the
+   display (menus twice the size); 1 = full TV resolution. */
+int display_scale=2;
+static int fs_active=0;
+static int fs_x=0,fs_y=0,fs_w=640,fs_h=512;
+static BITMAP *fsbuf=NULL;
+
+static void elk_present(BITMAP *src)
+{
+        if (!fs_active)
+        {
+                blit(src,screen,0,0,(winsizex-640)/2,(winsizey-512)/2,640,512);
+                return;
+        }
+        if (bitmap_color_depth(src)!=bitmap_color_depth(screen))
+        {
+                blit(src,fsbuf,0,0,0,0,640,512);
+                src=fsbuf;
+        }
+        if (fs_w==640 && fs_h==512) blit(src,screen,0,0,fs_x,fs_y,640,512);
+        else                        stretch_blit(src,screen,0,0,640,512,fs_x,fs_y,fs_w,fs_h);
+}
+
+#ifndef WIN32
+static void calc_fs_rect(int dw, int dh)
+{
+        int k;
+        switch (fs_scale)
+        {
+                case 2: /* fill */
+                fs_w=dw; fs_h=dh;
+                break;
+                case 1: /* 4:3 */
+                fs_h=dh; fs_w=(dh*4)/3;
+                if (fs_w>dw) { fs_w=dw; fs_h=(dw*3)/4; }
+                break;
+                default: /* integer */
+                k=dw/640;
+                if (dh/512<k) k=dh/512;
+                if (k<1) k=1;
+                fs_w=640*k; fs_h=512*k;
+                break;
+        }
+        fs_x=(dw-fs_w)/2;
+        fs_y=(dh-fs_h)/2;
+}
+#endif
+
 void enterfullscreen()
 {
         #ifdef WIN32
         destroy_bitmap(vidb);
-        #endif
         set_color_depth(desktop_color_depth());
         set_gfx_mode(GFX_AUTODETECT_FULLSCREEN,800,600,0,0);
-        #ifdef WIN32
         vp1=create_video_bitmap(800,600);
         vp2=create_video_bitmap(800,600);
         show_video_bitmap(vp2);
         vidb=create_video_bitmap(800,300);
         clear(vidb);
         install_mouse();
-        #endif
         set_color_depth(8);
         set_palette(elkpal);
         winsizex=800; winsizey=600;
+        #else
+        int dw=0,dh=0;
+        if (get_desktop_resolution(&dw,&dh)!=0 || dw<640 || dh<512)
+        {
+                dw=640; dh=512;
+        }
+        set_color_depth(desktop_color_depth());
+        /* A borderless desktop-sized window rather than Allegro's
+           "fullscreen" driver, which tries an XF86VidMode mode switch.
+           That switch fails (and X aborts the program) when the desktop
+           size is not a real video mode, e.g. with xrandr --scale. */
+        if (set_gfx_mode(GFX_AUTODETECT_WINDOWED,dw,dh,0,0)!=0)
+        {
+                set_gfx_mode(GFX_AUTODETECT_WINDOWED,640,512,0,0);
+                winsizex=640; winsizey=512;
+                set_color_depth(8);
+                set_palette(elkpal);
+                return;
+        }
+        if (!fsbuf) fsbuf=create_bitmap(640,512);
+        calc_fs_rect(SCREEN_W,SCREEN_H);
+        clear_to_color(screen,makecol(0,0,0));
+        fs_active=1;
+        set_color_depth(8);
+        set_palette(elkpal);
+        winsizex=SCREEN_W; winsizey=SCREEN_H;
+        #endif
 }
 
 void leavefullscreen()
 {
+        fs_active=0;
         #ifdef WIN32
         remove_mouse();
         destroy_bitmap(vidb);
