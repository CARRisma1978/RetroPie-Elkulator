 #include "elk.h"
 
 char ssname[260];
@@ -41,6 +43,43 @@ void endblit()
 
 int keylookup[128];
 
+/* Quit keys: ESC on the PC keyboard (the Electron's ESCAPE is normally
+   remapped to F1 in elk.cfg), or a gamepad button combination given in
+   elk.cfg as joy_quit_buttons = 10,11 (all listed buttons held together
+   on any one joystick).  Empty disables the gamepad combination. */
+#define MAX_QUIT_BUTTONS 8
+static int quit_buttons[MAX_QUIT_BUTTONS];
+static int num_quit_buttons=0;
+
+static void parse_quit_buttons()
+{
+        char tmp[64];
+        char *tok;
+        strncpy(tmp,joy_quit_buttons,sizeof(tmp)-1);
+        tmp[sizeof(tmp)-1]=0;
+        num_quit_buttons=0;
+        for (tok=strtok(tmp,", ");tok && num_quit_buttons<MAX_QUIT_BUTTONS;tok=strtok(NULL,", "))
+        {
+                int b=atoi(tok);
+                if (b>=0 && b<MAX_JOYSTICK_BUTTONS) quit_buttons[num_quit_buttons++]=b;
+        }
+}
+
+static int joy_quit_pressed()
+{
+        int j,c;
+        if (!num_quit_buttons) return 0;
+        for (j=0;j<num_joysticks;j++)
+        {
+                for (c=0;c<num_quit_buttons;c++)
+                {
+                        if (quit_buttons[c]>=joy[j].num_buttons || !joy[j].button[quit_buttons[c]].b) break;
+                }
+                if (c==num_quit_buttons) return 1;
+        }
+        return 0;
+}
+
 int main(int argc, char *argv[])
 {
         int ret = allegro_init();
@@ -58,10 +97,22 @@ int main(int argc, char *argv[])
                 enterfullscreen();
         }
         install_mouse();
-        while (!quited)
+        parse_quit_buttons();
         {
-                runelk();
-                if (menu_pressed()) entergui();
+                int esc_prev=key[KEY_ESC];
+                while (!quited)
+                {
+                        runelk();
+                        if (menu_pressed())
+                        {
+                                entergui();
+                                /* ESC may have been used to close the menu */
+                                esc_prev=1;
+                        }
+                        if (key[KEY_ESC] && !esc_prev) quited=1;
+                        esc_prev=key[KEY_ESC];
+                        if (joy_quit_pressed()) quited=1;
+                }
         }
         closeelk();
         return 0;
